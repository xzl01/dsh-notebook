{
  "name": "@local/dsh-notebook",
  "version": "0.1.0",
  "private": true,
  "description": "Notion-style Markdown notebook for the DeepSeek Harness Web UI, backed by an Obsidian vault, with folder pages, a streaming Ask AI sidebar and agent tools over the same notes.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzl01/dsh-notebook.git"
  },
  "homepage": "https://github.com/xzl01/dsh-notebook",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "obsidian",
    "notion",
    "markdown",
    "notes"
  ]
}